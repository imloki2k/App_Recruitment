<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="72dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Internship"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:padding="8dp" />

        <EditText
            android:id="@+id/editTextTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Internship Title"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"/>

        <EditText
            android:id="@+id/editTextLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Location"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"/>

        <EditText
            android:id="@+id/editTextDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Duration (e.g., 3 months)"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"/>

        <EditText
            android:id="@+id/editTextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Field (e.g., IT, Marketing)"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"/>

        <EditText
            android:id="@+id/editTextDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:minLines="3" />

        <EditText
            android:id="@+id/editTextRequirements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Requirements"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:minLines="2" />

        <EditText
            android:id="@+id/editTextStipend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stipend (e.g., $500)"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"/>

        <EditText
            android:id="@+id/editTextDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Deadline (e.g., 2025-08-01)"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/buttonUpdateInternship"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Internship"
            android:layout_marginTop="16dp"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>